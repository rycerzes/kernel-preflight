# Sandbox image for the Triton and Helion backends.
#
# Separate from Dockerfile.sandbox on purpose. The CUDA backend needs nvcc and
# nothing else; the Python backends need torch, Triton and Helion and never
# invoke nvcc. Keeping them apart means a CUDA-only preflight does not pay for a
# multi-gigabyte torch install, and a Triton preflight does not depend on a
# toolchain it never uses.
FROM kernel-preflight-sandbox:cuda13

# cu130 to match the driver on the host. Versions are pinned: an unpinned torch
# would silently change the reference implementation that every verdict is
# measured against.
# Triton JIT-compiles a small C extension (cuda_utils.c) on first use and needs
# Python headers to do it. Without python3-dev every Triton candidate fails with
# "Python.h: No such file or directory" at run time rather than build time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-dev build-essential \
 && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
      --index-url https://download.pytorch.org/whl/cu130 \
      torch==2.12.0

# Helion 1.4.0, released 2026-07-29 — past the 7-day release-age floor. It
# compiles to Triton, which ships inside the torch wheel.
#
# `packaging` is imported at runtime by this stack but declared by none of it, so
# the slim base image leaves it missing. The verification step below is what
# surfaced that rather than a preflight run failing later.
RUN pip3 install --no-cache-dir --break-system-packages helion==1.4.0 packaging setuptools

# Fail the build rather than a preflight run if the stack is not importable.
RUN python3 -c "\
import torch, triton, helion, importlib.metadata as m; \
print('torch', torch.__version__, 'triton', m.version('triton'), 'helion', m.version('helion')); \
assert hasattr(torch.nn.functional, 'scaled_dot_product_attention')"

# Two more kernel DSLs, appended after the torch layer on purpose: inserting a
# step before it invalidates the cache and re-downloads several gigabytes.
#
# nvidia-cutlass-dsl 4.7.0 rather than 4.7.1, which was published today and fails
# the 7-day release-age floor. The [cu13] extra matches the CUDA 13 toolkit here.
# CuTe DSL is in public beta, which is worth knowing when reading its numbers.
RUN pip3 install --no-cache-dir --break-system-packages \
      "nvidia-cutlass-dsl[cu13]==4.7.0"

# TileLang builds on TVM and is explicitly validated on the RTX 4090, which is
# the device this harness measures.
RUN pip3 install --no-cache-dir --break-system-packages tilelang==0.1.13

RUN python3 -c "\
import cutlass, tilelang, importlib.metadata as m; \
print('cutlass-dsl', m.version('nvidia-cutlass-dsl'), 'tilelang', m.version('tilelang'))"

ENTRYPOINT []
CMD ["sleep", "infinity"]
